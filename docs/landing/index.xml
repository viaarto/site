      <description>&lt;!doctype html&gt;&#xA;&lt;html lang=&#34;pt-br&#34;&gt;&#xA;&lt;head&gt;&#xA;  &lt;meta charset=&#34;utf-8&#34; /&gt;&#xA;  &lt;meta name=&#34;viewport&#34; content=&#34;width=device-width, initial-scale=1&#34; /&gt;&#xA;&#xA;  &lt;title&gt;Vaga Remota: Vendedor(a) Júnior/Pleno (B2B) | Via Arto&lt;/title&gt;&#xA;  &lt;meta name=&#34;description&#34; content=&#34;Vaga remota na Via Arto: Vendedor(a) Júnior/Pleno para Vendas B2B com prospecção ativa. Perfil desenrolado, organizado e com vontade de aprender.&#34; /&gt;&#xA;&#xA;  &lt;!-- Bootstrap (Async / igual ao site) --&gt;&#xA;  &lt;link rel=&#34;preload&#34; href=&#34;https://viaarto.com.br/css/bootstrap.min.css&#34; as=&#34;style&#34; onload=&#34;this.onload=null;this.rel=&#39;stylesheet&#39;&#34;&gt;&#xA;  &lt;noscript&gt;&lt;link rel=&#34;stylesheet&#34; href=&#34;https://viaarto.com.br/css/bootstrap.min.css&#34;&gt;&lt;/noscript&gt;&#xA;&#xA;  &lt;!-- Font Awesome (Async / igual ao site) --&gt;&#xA;  &lt;link rel=&#34;preload&#34; href=&#34;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css&#34; as=&#34;style&#34; onload=&#34;this.onload=null;this.rel=&#39;stylesheet&#39;&#34; integrity=&#34;sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==&#34; crossorigin=&#34;anonymous&#34; referrerpolicy=&#34;no-referrer&#34;&gt;&#xA;  &lt;noscript&gt;&lt;link rel=&#34;stylesheet&#34; href=&#34;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css&#34; integrity=&#34;sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==&#34; crossorigin=&#34;anonymous&#34; referrerpolicy=&#34;no-referrer&#34;&gt;&lt;/noscript&gt;&#xA;&#xA;  &lt;!-- Main Stylesheet (Async / igual ao site) --&gt;&#xA;  &lt;link rel=&#34;preload&#34; href=&#34;https://viaarto.com.br/scss/style.min.css&#34; as=&#34;style&#34; onload=&#34;this.onload=null;this.rel=&#39;stylesheet&#39;&#34;&gt;&#xA;  &lt;noscript&gt;&lt;link rel=&#34;stylesheet&#34; href=&#34;https://viaarto.com.br/scss/style.min.css&#34;&gt;&lt;/noscript&gt;&#xA;&#xA;  &lt;!-- Favicon (igual ao site) --&gt;&#xA;  &lt;link rel=&#34;shortcut icon&#34; href=&#34;https://viaarto.com.br/images/favicon.png&#34; type=&#34;image/x-icon&#34; /&gt;&#xA;  &lt;link rel=&#34;icon&#34; href=&#34;https://viaarto.com.br/images/favicon.ico&#34; type=&#34;image/x-icon&#34; /&gt;&#xA;&#xA;  &lt;!-- CSS mínimo só para ajustes específicos desta página (sem “cara de IA”) --&gt;&#xA;  &lt;style&gt;&#xA;    /* Mantém o visual do tema do site; aqui só ajustamos pequenos detalhes */&#xA;    .job-hero .badge{&#xA;      font-weight: 600;&#xA;      border: 1px solid rgba(0,0,0,.08);&#xA;      background: rgba(255,255,255,.85);&#xA;      backdrop-filter: blur(6px);&#xA;    }&#xA;    .job-card{&#xA;      border-radius: 16px;&#xA;      overflow: hidden;&#xA;    }&#xA;    .job-list li{ margin-bottom: .5rem; }&#xA;    .job-cta{ gap: .75rem; display:flex; flex-wrap:wrap; align-items:center; }&#xA;    .job-cta .btn{ border-radius: 999px; padding-left: 1.1rem; padding-right: 1.1rem; }&#xA;    .job-muted{ opacity: .85; }&#xA;    .job-email{ font-weight: 800; }&#xA;&#xA;    /* Ajuste para navbar comportar logo maior */&#xA;    .navbar.site-navigation{&#xA;      padding-top: 12px;&#xA;      padding-bottom: 12px;&#xA;    }&#xA;    @media (max-width: 991.98px){&#xA;      .navbar-brand img{&#xA;        height: 52px;&#xA;      }&#xA;    }&#xA;  &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&#xA;&lt;body&gt;&#xA;  &lt;!-- NAVBAR (reaproveitando classes/estrutura do site) --&gt;&#xA;  &lt;nav class=&#34;navbar navbar-expand-lg site-navigation&#34;&gt;&#xA;    &lt;div class=&#34;container&#34;&gt;&#xA;      &lt;a class=&#34;navbar-brand&#34; href=&#34;https://viaarto.com.br/&#34; aria-label=&#34;Via Arto - Home&#34;&gt;&#xA;          &lt;img src=&#34;https://viaarto.com.br/images/logo-viaarto-redondo-transparente.webp&#34; alt=&#34;Via Arto&#34; style=&#34;height:64px; width:auto;&#34;&gt;&#xA;        &lt;/a&gt;&#xA;      &lt;button class=&#34;navbar-toggler&#34; type=&#34;button&#34; data-toggle=&#34;collapse&#34; data-target=&#34;#navbarMenu&#34; aria-controls=&#34;navbarMenu&#34; aria-expanded=&#34;false&#34; aria-label=&#34;Abrir menu&#34;&gt;&#xA;        &lt;span class=&#34;navbar-toggler-icon&#34;&gt;&lt;/span&gt;&#xA;      &lt;/button&gt;&#xA;&#xA;      &lt;div class=&#34;collapse navbar-collapse&#34; id=&#34;navbarMenu&#34;&gt;&#xA;        &lt;ul class=&#34;navbar-nav ml-auto&#34;&gt;&#xA;          &lt;li class=&#34;nav-item&#34;&gt;&lt;a class=&#34;nav-link&#34; href=&#34;https://viaarto.com.br/&#34;&gt;Home&lt;/a&gt;&lt;/li&gt;&#xA;          &lt;li class=&#34;nav-item&#34;&gt;&lt;a class=&#34;nav-link&#34; href=&#34;https://viaarto.com.br/quem-e-a-via-arto/&#34;&gt;Quem é a Via Arto&lt;/a&gt;&lt;/li&gt;&#xA;          &lt;li class=&#34;nav-item&#34;&gt;&lt;a class=&#34;nav-link&#34; href=&#34;https://viaarto.com.br/produtos-e-servicos/&#34;&gt;Nossos Produtos &amp;amp; Serviços&lt;/a&gt;&lt;/li&gt;&#xA;          &lt;li class=&#34;nav-item&#34;&gt;&lt;a class=&#34;nav-link&#34; href=&#34;https://viaarto.com.br/catalogo/&#34;&gt;Catálogo de Produtos&lt;/a&gt;&lt;/li&gt;&#xA;          &lt;li class=&#34;nav-item&#34;&gt;&lt;a class=&#34;nav-link&#34; href=&#34;https://viaarto.com.br/contato/&#34;&gt;Entre em contato&lt;/a&gt;&lt;/li&gt;&#xA;        &lt;/ul&gt;&#xA;      &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/nav&gt;&#xA;&#xA;  &lt;main&gt;&#xA;    &lt;section class=&#34;section job-hero&#34; style=&#34;padding-top: 90px; padding-bottom: 60px;&#34;&gt;&#xA;      &lt;div class=&#34;container&#34;&gt;&#xA;        &lt;div class=&#34;row align-items-center&#34;&gt;&#xA;          &lt;div class=&#34;col-lg-8&#34;&gt;&#xA;            &lt;div class=&#34;badge d-inline-flex align-items-center px-3 py-2 mb-3&#34; style=&#34;border-radius: 999px;&#34;&gt;&#xA;              &lt;i class=&#34;fa-solid fa-circle-check mr-2&#34; style=&#34;color: #14b8a6;&#34;&gt;&lt;/i&gt;&#xA;              &lt;span&gt;Vaga aberta • Comercial • Vendas B2B • &lt;strong&gt;Remota&lt;/strong&gt;&lt;/span&gt;&#xA;            &lt;/div&gt;&#xA;&#xA;            &lt;h1 class=&#34;mb-3&#34;&gt;Vendedor(a) Júnior / Pleno — Remoto&lt;/h1&gt;&#xA;&#xA;            &lt;p class=&#34;job-muted mb-4&#34;&gt;&#xA;              A &lt;strong&gt;Via Arto&lt;/strong&gt; está em fase de crescimento e estruturação comercial. Buscamos uma pessoa&#xA;              &lt;strong&gt;desenrolada&lt;/strong&gt;, com desenvoltura, vontade de aprender, &lt;strong&gt;sem vergonha de prospectar&lt;/strong&gt;&#xA;              e que aguente ouvir muitos “nãos” até dar certo — além de ser &lt;strong&gt;organizada&lt;/strong&gt; para manter rotina e follow-up.&#xA;            &lt;/p&gt;</description>
